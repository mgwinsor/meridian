@startuml

title Meridian — Package Architecture

skinparam componentStyle rectangle
skinparam packageStyle rectangle
' skinparam linetype ortho

package "cmd" {
    component "server\n<<composition root>>" as Server
}

package "Application Packages\n(internal/)" {
    component "account" as Account
    component "cash" as Cash
    component "property" as Property
    component "instrument" as Instrument
    component "position" as Position
    component "price" as Price
    component "money" as Money
    component "currency" as Currency
    component "health" as Health
}

' Composition root
Server --> Account
Server --> Cash
Server --> Health
Server --> Property
Server --> Instrument
Server --> Position
Server --> Price

' Internal package dependencies
Cash --> Account
Cash --> Money
Cash --> Currency

Property --> Money
Property --> Currency

Money --> Currency

Instrument --> Currency

Position --> Account
Position --> Instrument

Price --> Instrument
Price --> Money

@enduml
