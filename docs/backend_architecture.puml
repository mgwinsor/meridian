@startuml

title Meridian — Package Architecture

left to right direction

skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false
skinparam nodesep 35
skinparam ranksep 55


package "cmd" {
    component "server" as Server <<composition root>>
    component "db" as DBCommand <<goose migrations>>
}

package "internal" {
    together {
        component "account" as Account
        component "cash" as Cash
        component "property" as Property
        component "instrument" as Instrument
        component "position" as Position
        component "price" as Price
        component "fx" as FX
        component "overview" as Overview
    }

    together {
        component "money" as Money
        component "currency" as Currency
        component "assetclass" as AssetClass
    }

    together {
        component "health" as Health
        component "database" as Database
    }
}

database "PostgreSQL" as Postgres

' Composition root wiring
Server ..> Account
Server ..> Cash
Server ..> Property
Server ..> Instrument
Server ..> Position
Server ..> Price
Server ..> FX
Server ..> Overview
Server ..> Health
Server ..> Database

' Command dependencies
DBCommand --> Database

' Internal package dependencies
Cash --> Account
Cash --> Money
Cash --> Currency

Property --> Money
Property --> Currency

Instrument --> Currency
Instrument --> AssetClass

Position --> Account
Position --> Instrument

Price --> Instrument
Price --> Money

FX --> Currency
Overview --> Account
Overview --> Cash
Overview --> Property
Overview --> Instrument
Overview --> Position
Overview --> Price
Overview --> FX
Overview --> AssetClass

Money --> Currency

' Database access
Database -[#78909C]-> Postgres
Account -[#78909C]-> Postgres
Cash -[#78909C]-> Postgres
Property -[#78909C]-> Postgres
Instrument -[#78909C]-> Postgres
Position -[#78909C]-> Postgres
Price -[#78909C]-> Postgres
FX -[#78909C]-> Postgres
Overview -[#78909C]-> Postgres : read-only transaction
note right of Overview
  Input reader coordinates feature repositories.
  No overview-owned source queries or persistence.
end note

legend bottom left
    Dotted arrows: composition root wiring
    Solid arrows: package dependencies
    Blue-gray arrows: database access
endlegend

@enduml
